{
  "currency": "USD",
  "display_name": "HTTP Relay",
  "documents": {
    "Connectivity test": {
      "$doc_preset": "api_connectivity"
    },
    "How to use this service": {
      "category": "getting_started",
      "description": "Relay to your own HTTP endpoint stored as secrets (the free http_relay channel)",
      "file_path": "byok-description.md",
      "is_active": true,
      "is_public": true,
      "mime_type": "markdown"
    },
    "Multiple relays via enrollment": {
      "category": "getting_started",
      "description": "Run multiple metered relays, one endpoint per enrollment (the plus channel)",
      "file_path": "relay-description.md",
      "is_active": true,
      "is_public": true,
      "mime_type": "markdown"
    },
    "Python code example": {
      "$doc_preset": "api_code_example_requests"
    },
    "Shell code example": {
      "$doc_preset": "api_code_example_shell"
    }
  },
  "list_price": {
    "channels": {
      "http_relay": {
        "description": "Free \u2014 you relay to your own stored endpoint",
        "price": "0",
        "type": "constant"
      },
      "plus": {
        "description": "$1 for every 10,000 requests \u2014 pay only for what you relay",
        "price": "0.0001",
        "type": "constant"
      }
    },
    "default": "http_relay",
    "type": "channel"
  },
  "name": "http-relay",
  "service_options": {
    "ops_testing_parameters": {
      "api_key_secret": "HTTP_RELAY_API_KEY",
      "base_url": "https://echo.unitysvc.dev"
    }
  },
  "status": "ready",
  "time_created": "2026-04-07T00:00:00Z",
  "user_access_interfaces": {
    "enrollment": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ enrollment.code }}"
    },
    "http_gateway": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ service_name }}"
    }
  },
  "user_parameters_schema": {
    "properties": {
      "api_key_secret": {
        "default": "HTTP_RELAY_API_KEY",
        "description": "Name of the customer secret holding the API key. Defaults to HTTP_RELAY_API_KEY (shared with the free http_relay channel) so empty-params enrollments reuse the seeded testing secret. Override per enrollment to bind a different key.",
        "type": "string"
      },
      "base_url": {
        "default": "https://echo.unitysvc.dev",
        "description": "Upstream base URL for this enrollment, specified directly (e.g. https://api.example.com)",
        "type": "string"
      }
    },
    "required": [
      "base_url"
    ],
    "type": "object"
  }
}
