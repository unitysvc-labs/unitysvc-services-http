{
  "currency": "USD",
  "display_name": "HTTP Relay (Multi-Enrollment)",
  "documents": {
    "Connectivity test": {
      "$doc_preset": "api_connectivity"
    },
    "How to use this service": {
      "category": "getting_started",
      "description": "Guide to setting up multiple HTTP relay enrollments",
      "file_path": "relay-description.md",
      "is_active": true,
      "is_public": true,
      "mime_type": "markdown"
    },
    "Python code example": {
      "$doc_preset": "api_code_example_requests"
    },
    "Shell code example": {
      "$doc_preset": "api_code_example_shell"
    }
  },
  "list_price": {
    "description": "$1 for every 10,000 requests \u2014 pay only for what you relay",
    "price": "0.0001",
    "type": "constant"
  },
  "name": "labs/http-relay-plus",
  "schema": "listing_v1",
  "service_options": {
    "enrollment_vars": {
      "code": "{{ enrollment_code(6) }}"
    },
    "ops_testing_parameters": {
      "api_key_secret": "HTTP_RELAY_API_KEY",
      "base_url": "https://echo.unitysvc.dev"
    }
  },
  "status": "ready",
  "time_created": "2026-04-07T00:00:00Z",
  "user_access_interfaces": {
    "http_gateway": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ enrollment_vars.code }}"
    }
  },
  "user_parameters_schema": {
    "properties": {
      "api_key_secret": {
        "default": "HTTP_RELAY_API_KEY",
        "description": "Name of the customer secret containing the API key. Defaults to HTTP_RELAY_API_KEY (the name the non-plus `http-relay` uses) so that empty-params enrollments share the seller-seeded testing secret. Override to a per-enrollment name to bind a different key.",
        "type": "string"
      },
      "base_url": {
        "default": "https://echo.unitysvc.dev",
        "description": "Upstream base URL, specified directly (e.g. https://api.example.com)",
        "type": "string"
      }
    },
    "required": [
      "base_url"
    ],
    "type": "object"
  }
}
