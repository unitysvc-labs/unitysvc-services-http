import os
import sys

import httpx

# Deliver an email to a UnitySVC SMTP Gateway route (http-to-smtp-gateway).
# POST the `email` payload — the same shape the smtp-to-http converter emits —
# and the platform submits it to the SMTP Gateway as you: your API key is
# replayed as the SMTP password, your chosen route is the SMTP username.
#   default channel : route from HTTP_TO_SMTP_GATEWAY_TARGET (free)
#   plus channel    : per-enrollment route, reached at /e/<code> ($1/1,000)
{% if local_testing %}
# http-to-smtp-gateway is gateway-native (notify://smtp): there is no seller
# upstream to call in local mode, so this branch only confirms wiring.
print("sent (skipped: gateway-native notify://smtp, no upstream)")
sys.exit(0)
{% else %}
response = httpx.post(
    "{{ service_base_url }}",
    headers={"Authorization": f"Bearer {k}"} if (k := os.environ.get("UNITYSVC_API_KEY")) else {},
    json={
        "from": "alerts@example.com",
        "to": ["oncall@example.com"],
        "subject": "Disk alert: clickhouse at 92%",
        "text_body": "clickhouse disk 92%",
        "html_body": "<p>clickhouse disk <b>92%</b></p>",
        "headers": {"In-Reply-To": "<incident-4711@example.com>"},
    },
)
response.raise_for_status()
print(f"sent (HTTP {response.status_code})")
{% endif %}
